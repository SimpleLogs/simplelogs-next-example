# Server-only. Never prefix this with NEXT_PUBLIC_ — that would ship it to the
# browser, where anyone could read it.
SIMPLELOGS_SERVER_KEY=sk_replace_me

# Read during the server render of the root layout and handed down to the
# client through context, so it does not need the NEXT_PUBLIC_ prefix either.
SIMPLELOGS_CLIENT_KEY=ck_replace_me
