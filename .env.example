# Server-only, and never prefixed with NEXT_PUBLIC_ — that would ship a secret
# to the browser. The server SDK reads this from the environment at request
# time, so route handlers and server components are configured without it being
# passed to the provider, and it never has to be present at build time.
SIMPLELOGS_SERVER_KEY=sk_replace_me

# Public by design and origin-locked in the dashboard, so it belongs in the
# client bundle — which is the only way a value reaches the browser.
#
# NEXT_PUBLIC_ is inlined at BUILD time, so this must be set wherever you build,
# not only wherever you run. Note that dropping the prefix would not change
# that: the root layout prerenders, so an unprefixed read there is captured at
# build too. The prefix makes that visible rather than accidental.
NEXT_PUBLIC_SIMPLELOGS_CLIENT_KEY=ck_replace_me

# Optional, and self-hosted installs only — the SDK defaults to the hosted
# collector. Read this before setting it.
#
# Set it in BOTH environments: wherever you build AND wherever you run. It is
# captured at build time for the browser and read per request on the server,
# and it has no NEXT_PUBLIC_ prefix to warn you which is which.
#
# Setting only one splits the data rather than failing, and the half that goes
# astray goes to the SDK's default — outside your deployment. Measured, one
# page load and one checkout:
#
#   set at run time only:    browser 0, server 2   (browser telemetry escapes)
#   set at build time only:  browser 6, server 0   (server entries escape)
#   set in both:             everything arrives
#
# Half a trace reads as a correlation bug rather than a configuration one,
# which is what makes either direction expensive to diagnose.
# SIMPLELOGS_API_ENDPOINT=https://logs.example.com/api/v1
