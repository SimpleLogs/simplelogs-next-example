# Server-only, and never prefixed with NEXT_PUBLIC_ — that would ship a secret
# to the browser. The server SDK reads this from the environment at request
# time, so route handlers and server components are configured without it being
# passed to the provider, and it never has to be present at build time.
SIMPLELOGS_SERVER_KEY=sk_replace_me

# Public by design and origin-locked in the dashboard, so it belongs in the
# client bundle — which is the only way a value reaches the browser.
#
# NEXT_PUBLIC_ is inlined at BUILD time, so this must be set wherever you build,
# not only wherever you run. Note that dropping the prefix would not change
# that: the root layout prerenders, so an unprefixed read there is captured at
# build too. The prefix makes that visible rather than accidental.
NEXT_PUBLIC_SIMPLELOGS_CLIENT_KEY=ck_replace_me

# Optional, and self-hosted installs only — the SDK defaults to the hosted
# collector. Read this before setting it.
#
# Set it in BOTH environments: wherever you build AND wherever you run. It is
# captured at build time for the browser and read per request on the server,
# and it has no NEXT_PUBLIC_ prefix to warn you which is which.
#
# Setting only one splits the data rather than failing, and the half that goes
# astray goes to the SDK's default — outside your deployment. Measured, one
# page load and one checkout, counting ENTRIES only:
#
#   set at run time only:    browser 0, server 2   (browser entries escape)
#   set at build time only:  browser 6, server 0   (server entries escape)
#   set in both:             everything arrives
#
# Half a trace reads as a correlation bug rather than a configuration one,
# which is what makes either direction expensive to diagnose.
#
# Browser traces and logs, from initBrowserOtel() in instrumentation-client.js,
# follow this same value — their exporters resolve the URL at send time from
# the config the provider forwarded, so there is nothing extra to set. Measured
# against a local collector, one page load and one checkout put
# /api/otlp/v1/traces and /api/otlp/v1/logs on this host. That /api/otlp prefix
# is part of the URL DERIVED from this value; the override below does not get
# it. See "Self-hosted collectors" in the README.
# SIMPLELOGS_API_ENDPOINT=https://logs.example.com/api/v1

# Optional, and only for a deployment whose OpenTelemetry collector is not its
# SimpleLogs install. This moves the browser's OTLP signals — its traces AND
# its logs — to that host, while its entries and replay settings stay on
# SIMPLELOGS_API_ENDPOINT.
#
# Set it in BOTH environments, for the same reason as above: it reaches the
# browser through the same prerendered render, so it is captured at build time
# there and has the same trap.
#
# Used verbatim: the exporter posts to <endpoint>/v1/traces and
# <endpoint>/v1/logs. The /api/otlp prefix belongs to the URL derived from
# SIMPLELOGS_API_ENDPOINT and is not added here. Measured with this set to
# http://127.0.0.1:8888 and the endpoint above on :9999:
#
#   http://127.0.0.1:8888/v1/traces          browser traces
#   http://127.0.0.1:8888/v1/logs            browser logs
#   http://127.0.0.1:9999/api/v1/replay/...  browser entries, unmoved
#
# "unmoved" is the point: entry sends — replay settings and /enqueue alike —
# keep following SIMPLELOGS_API_ENDPOINT. Only the two OTLP signals move.
# SIMPLELOGS_OTLP_BROWSER_ENDPOINT=https://otlp.example.com
